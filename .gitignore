# Keep only source code, tests, migrations, and project configuration in Git.
*

# Project files at the repository root.
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/README.md
!/alembic.ini
!/docker-compose.yml
!/pyproject.toml
!/requirements.txt

# Python application source.
!/app/
!/app/**/
!/app/**/*.py

# Alembic migrations and template.
!/alembic/
!/alembic/**/
!/alembic/**/*.py
!/alembic/script.py.mako

# Automated tests.
!/tests/
!/tests/**/
!/tests/**/*.py

# Maintenance and migration scripts.
!/scripts/
!/scripts/**/
!/scripts/**/*.py

# Deployment configurations
!/deploy/
!/deploy/**

# Documentation
!/docs/
!/docs/**

# Mini App source and build configuration (generated files stay local).
!/miniapp/
!/miniapp/**/
!/miniapp/**/*.js
!/miniapp/**/*.css
!/miniapp/**/*.html
!/miniapp/**/*.json
!/miniapp/Dockerfile
/miniapp/node_modules/
/miniapp/dist/

# Marketing website source and configuration (build artifacts stay local).
!/marketing/
!/marketing/**/
!/marketing/**/*.ts
!/marketing/**/*.tsx
!/marketing/**/*.js
!/marketing/**/*.css
!/marketing/**/*.html
!/marketing/**/*.json
!/marketing/**/*.svg
!/marketing/**/*.xml
!/marketing/**/*.txt
/marketing/node_modules/
/marketing/dist/

