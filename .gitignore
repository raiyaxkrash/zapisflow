# Keep only source code, tests, migrations, and project configuration in Git.
*

# Project files at the repository root.
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/README.md
!/alembic.ini
!/docker-compose.yml
!/pyproject.toml
!/requirements.txt

# Python application source.
!/app/
!/app/**/
!/app/**/*.py

# Alembic migrations and template.
!/alembic/
!/alembic/**/
!/alembic/**/*.py
!/alembic/script.py.mako

# Automated tests.
!/tests/
!/tests/**/
!/tests/**/*.py

# Maintenance and migration scripts.
!/scripts/
!/scripts/**/
!/scripts/**/*.py

