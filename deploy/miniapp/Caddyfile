:8080 {
	root * /srv
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self'; img-src 'self' blob: data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org"
	}
	@entry path /b/*
	handle @entry {
		header Cache-Control no-store
		rewrite * /index.html
		file_server
	}
	handle {
		file_server
	}
}
