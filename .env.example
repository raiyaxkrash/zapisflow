# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Список Telegram ID администраторов через запятую
ADMIN_IDS=123456789,987654321

# База данных PostgreSQL (asyncpg)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=beauty_bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password

# Redis для FSM и распределенных блокировок
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Часовой пояс по умолчанию
TIMEZONE=Europe/Moscow

# Настройки по умолчанию
HOLD_DURATION_MINUTES=30
MIN_ADVANCE_HOURS=2
MAX_ADVANCE_DAYS=30
DEFAULT_BUFFER_MINUTES=30
GRID_STEP_MINUTES=30

# Банковские реквизиты по умолчанию для предоплаты
DEFAULT_BANK_NAME=Сбербанк
DEFAULT_CARD_NUMBER=2202 2000 0000 0000
DEFAULT_PHONE_REQUISITES=+7 (999) 000-00-00
DEFAULT_RECIPIENT_NAME=Иван И.
