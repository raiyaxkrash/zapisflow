# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=

# Docker Compose запускает backend в production webhook-режиме.
APP_ENV=production
DOMAIN=api.example.com

# Список Telegram ID администраторов в формате JSON
ADMIN_IDS=[123456789,987654321]

# Пароль для PostgreSQL (для docker-compose)
POSTGRES_PASSWORD=your_secure_password_here

# Канонический URL подключения к PostgreSQL 16 (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@postgres:5432/beauty_bot_db

# Настройки пула соединений PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis для FSM и распределенных блокировок
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace_with_secure_redis_password
PAYMENT_PROVIDER=disabled
# YooKassa redirect payments use the provider confirmation URL. Live digital
# SaaS sales from Telegram require a separate Telegram rules review.
PAYMENT_CURRENCY=RUB
YOOKASSA_MODE=test
YOOKASSA_ALLOW_TEST_IN_PRODUCTION=false
YOOKASSA_TEST_ALLOWED_TELEGRAM_IDS=[]
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TEST_SHOP_ID=
YOOKASSA_TEST_SECRET_KEY=
BILLING_DOMAIN=pay.zapisflow.su
BILLING_RETURN_URL=https://zapisflow.su/
# ZapisFlow owner is self-employed: register income and issue a receipt in Мой налог.
YOOKASSA_FISCAL_MODE=self_employed
# Only for a merchant configured to use YooKassa fiscal receipts:
YOOKASSA_RECEIPT_VAT_CODE=
YOOKASSA_RECEIPT_PAYMENT_SUBJECT=
YOOKASSA_RECEIPT_PAYMENT_MODE=
YOOKASSA_RECONCILIATION_INTERVAL_SECONDS=300

# Часовой пояс по умолчанию
TIMEZONE=Europe/Moscow

# Настройки по умолчанию
HOLD_DURATION_MINUTES=30
MIN_ADVANCE_HOURS=2
MAX_ADVANCE_DAYS=30
DEFAULT_BUFFER_MINUTES=30
GRID_STEP_MINUTES=30

# Клиентские реквизиты задаются отдельно в настройках каждого проекта.
# Не задавайте здесь общие реквизиты: они могут направить платеж не тому мастеру.
BANK_NAME=
BANK_CARD_NUMBER=
DEFAULT_PHONE_REQUISITES=
BANK_RECIPIENT_NAME=

# Phase 5 & 6: Безопасное хранение токенов и реестр ботов
# Мастер-ключ шифрования токенов AES-256 (64 hex-символа или 44 base64-символа)
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
BOT_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX_KEY
BOT_REGISTRY_CACHE_MAX_SIZE=500
BOT_REGISTRY_CACHE_TTL_SECONDS=300
BOT_REGISTRY_INVALIDATION_CHANNEL=bot_registry:invalidate

# Phase 6: Режим приложения и Webhook шлюз
APP_MODE=webhook
WEBHOOK_BASE_URL=https://api.example.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_UPDATE_DEDUP_TTL=86400

# Phase 7: Управляющий бот платформы (Manager Bot) и онбординг
MANAGER_BOT_TOKEN=
MANAGER_WEBHOOK_SECRET=
TRIAL_DURATION_DAYS=14
SUPPORT_TELEGRAM_USERNAME=zapisflow
