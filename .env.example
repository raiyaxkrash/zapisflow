# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=

# Список Telegram ID администраторов в формате JSON
ADMIN_IDS=[123456789,987654321]

# Пароль для PostgreSQL (для docker-compose)
POSTGRES_PASSWORD=your_secure_password_here

# Канонический URL подключения к PostgreSQL 16 (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/beauty_bot_db

# Настройки пула соединений PostgreSQL
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis для FSM и распределенных блокировок
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Часовой пояс по умолчанию
TIMEZONE=Europe/Moscow

# Настройки по умолчанию
HOLD_DURATION_MINUTES=30
MIN_ADVANCE_HOURS=2
MAX_ADVANCE_DAYS=30
DEFAULT_BUFFER_MINUTES=30
GRID_STEP_MINUTES=30

# Банковские реквизиты по умолчанию для предоплаты
BANK_NAME=Сбербанк
BANK_CARD_NUMBER=2202 2000 0000 0000
DEFAULT_PHONE_REQUISITES=+7 (999) 000-00-00
BANK_RECIPIENT_NAME=Иван И.

# Phase 5 & 6: Безопасное хранение токенов и реестр ботов
# Мастер-ключ шифрования токенов AES-256 (64 hex-символа или 44 base64-символа)
# Сгенерировать ключ: python -c "import secrets; print(secrets.token_hex(32))"
BOT_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_32_BYTE_HEX_KEY
BOT_REGISTRY_CACHE_MAX_SIZE=500
BOT_REGISTRY_CACHE_TTL_SECONDS=300
BOT_REGISTRY_INVALIDATION_CHANNEL=bot_registry:invalidate

# Phase 6: Режим приложения и Webhook шлюз
APP_MODE=polling
WEBHOOK_BASE_URL=https://beautybot.example.com
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_MAX_BODY_BYTES=1048576
WEBHOOK_UPDATE_DEDUP_TTL=86400

# Phase 7: Управляющий бот платформы (Manager Bot) и онбординг
MANAGER_BOT_TOKEN=
MANAGER_WEBHOOK_SECRET=
TRIAL_DURATION_DAYS=14
